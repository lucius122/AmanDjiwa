# Salin ke .env lalu isi. Jangan commit .env.

# Backend
DATABASE_URL=postgresql+asyncpg://amandjiwa:amandjiwa@127.0.0.1:5433/amandjiwa
REDIS_URL=redis://127.0.0.1:6379/0
# base64 dari 32 byte acak: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
MESSAGE_ENC_KEY=
# minimal 32 karakter acak
JWT_SECRET=
# Origin frontend (CORS + tautan di email wali & reset password). Produksi: URL Vercel / https://<SITE_ADDRESS>
FRONTEND_ORIGIN=http://localhost:5173
# Demo hackathon: izinkan `python -m app.cli seed-demo` (data SINTETIS) & label "data contoh"
# di dasbor kota. JANGAN true di server yang dipakai remaja sungguhan.
DEMO_MODE=false

# Email (dev: Mailpit dari docker-compose, buka http://localhost:8025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AmanDjiwa <no-reply@amandjiwa.local>

# LLM opsional untuk balasan level hijau (NVIDIA NIM, build.nvidia.com). Kosong = bank respons saja.
NVIDIA_API_KEY=

# Telegram (@BotFather). Kosong = bot nonaktif. Dev: `uv run python -m app.bot.polling`.
# Produksi: `uv run python -m app.cli telegram-webhook` (butuh HTTPS publik).
TELEGRAM_BOT_TOKEN=
# acak, min. 32 karakter; dicek di header X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
# Handle bot tanpa @. Default AmanDjiwa_bot; buka komentar hanya kalau memakai bot lain.
# TELEGRAM_BOT_USERNAME=AmanDjiwa_bot

# Frontend (Vite). Di Docker, VITE_API_URL otomatis /api (Caddy meneruskan ke backend).
VITE_API_URL=http://localhost:8000

# ---------- Docker Compose (--profile app) ----------
# Password Postgres container (berlaku saat volume pgdata pertama kali dibuat).
POSTGRES_PASSWORD=
# Domain publik untuk HTTPS otomatis Caddy, mis. amandjiwa.example.id. ":80" = HTTP lokal.
SITE_ADDRESS=localhost
# SMTP dari dalam container backend (default: mailpit dev). Produksi: host SMTP asli.
DOCKER_SMTP_HOST=
DOCKER_SMTP_PORT=
